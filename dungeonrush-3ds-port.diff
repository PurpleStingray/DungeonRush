+#ifdef __3DS__
+// Native art tiles are 16x16 (see res/drawable/0x72_DungeonTilesetII_v1_3
+// manifest). On desktop these are drawn at 2x (see SCALE_FACTOR in
+// render.c) into a 1440x960 window. The 3DS top screen is a fixed
+// 400x240, so instead of rendering the desktop-sized scene and
+// downscaling it (soft/blurry, and expensive for the software
+// renderer), we draw pixel art at its native 1x size and let UNIT
+// (the map tile grid spacing) shrink to match. 400/16=25 and
+// 240/16=15 tiles, so the grid divides the screen exactly.
+#define UNIT 16
+#define SCREEN_WIDTH 400
+#define SCREEN_HEIGHT 240
+// RomFS assets are addressed as "romfs:/res/..." rather than the
+// desktop build's plain relative "res/..." paths.
+#define RES_PREFIX "romfs:/"
+#else
 #define UNIT 32
 #define SCREEN_WIDTH 1440
 #define SCREEN_HEIGHT 960
+#define RES_PREFIX ""
+#endif
 #define FONT_SIZE 32
